# Supabase Transaction pooler connection string used by Prisma on Render.
# Copy the exact Transaction pooler URL from Supabase Dashboard > Connect.
# It uses port 6543 and a username like postgres.PROJECT-REF.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true&connection_limit=1"

# Used by the JWT session cookie.
JWT_SECRET="replace-with-a-long-random-secret"
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_FROM="StockSync <noreply@your-verified-domain.com>"
APP_URL="https://your-app.onrender.com"